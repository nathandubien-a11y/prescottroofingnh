Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On

# Old flat location slugs -> canonical paths (301, no trailing slash)
RewriteRule ^roofing-manchester-nh/?$ /roofing/manchester-nh [R=301,L]
RewriteRule ^roofing-nashua-nh/?$ /roofing/nashua-nh [R=301,L]
RewriteRule ^roofing-bedford-nh/?$ /roofing/bedford-nh [R=301,L]

# Strip trailing slashes (except root)
RewriteCond %{REQUEST_FILENAME} !-d [OR]
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve extensionless routes from their .html file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

ErrorDocument 404 /404.html
